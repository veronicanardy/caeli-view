# Normaliza line endings: o repositório guarda sempre LF nos blobs.
# Sem isso, o resultado depende do core.autocrlf de cada máquina; com isso,
# o Pint (que exige LF) e os diffs ficam estáveis em qualquer sistema.
* text=auto eol=lf

# Arquivos binários: nunca normalizar.
*.glb binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
